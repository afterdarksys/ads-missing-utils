{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/afterdarksys/ads-missing-utils/schemas/response-v1.json",
  "type": "object",
  "required": ["schema", "command", "outcome", "data"],
  "properties": {
    "schema": { "const": "missing-utils/response/v1" },
    "command": { "enum": ["jwalk", "envsub", "hashsum"] },
    "outcome": { "enum": ["pass", "fail", "partial", "error"] },
    "data": {},
    "diagnostics": { "type": "array" }
  }
}
