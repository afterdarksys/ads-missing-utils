{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "source",
    "context",
    "collected_at",
    "collector_version",
    "outcome",
    "events",
    "ignored",
    "groups",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "missing-utils/eventwhy/v1"
    },
    "source": {
      "enum": [
        "cli",
        "provided"
      ]
    },
    "context": {
      "type": "string"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "collector_version": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "pass",
        "partial"
      ]
    },
    "events": {
      "type": "integer",
      "minimum": 0
    },
    "ignored": {
      "type": "integer",
      "minimum": 0
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource",
          "action",
          "count",
          "first",
          "last"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "first": {
            "type": "string",
            "format": "date-time"
          },
          "last": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
